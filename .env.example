# Copy these values into your shell, secret manager, or process supervisor.
# Simphony does not automatically load this file.

# Required whenever the dashboard/API server is enabled. Generate a random
# value of at least 32 characters and store it in the process supervisor.
SIMPHONY_OPERATOR_TOKEN=replace-with-a-random-32-character-or-longer-token

# Optional comma-separated exact browser origins (scheme, host, and port).
# Same-origin dashboard access needs no entry.
SIMPHONY_TRUSTED_ORIGINS=

# Optional exact development endpoints allowed to use HTTP/private addresses.
# Never use broad production network ranges here.
SIMPHONY_TRUSTED_OUTBOUND_ORIGINS=

# Linear tracker API token used when WORKFLOW.md has tracker.api_key: $LINEAR_API_KEY.
LINEAR_API_KEY=replace-with-your-linear-api-key

# Codex/OpenAI authentication, if required by your local Codex installation.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Claude authentication, used when WORKFLOW.md has agent_runtime.provider: claude.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Z.ai GLM coding-plan authentication (Anthropic-compatible gateway).
ZAI_API_KEY=replace-with-your-zai-api-key

# Moonshot Kimi authentication. KIMI_API_KEY matches the harness convention used
# in dashboard presets; MOONSHOT_API_KEY is the vendor-conventional name.
# Either can be referenced from WORKFLOW.md as $KIMI_API_KEY or $MOONSHOT_API_KEY.
KIMI_API_KEY=replace-with-your-kimi-api-key
MOONSHOT_API_KEY=replace-with-your-moonshot-api-key

# DeepSeek authentication.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Optional compatible gateway endpoints.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
